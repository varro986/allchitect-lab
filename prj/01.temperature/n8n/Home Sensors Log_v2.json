        "jsCode": "/**\n * Nodo: Code in JavaScript (n8n)\n * Funzione: Allineamento del JSON piatto agli Header reali di Google Sheets.\n * Strategia: Minimalista con inserimento Timestamp corrente.\n */\n\n// 1. RECUPERO INPUT\n// Recuperiamo i dati reali dal nodo \"Merged Data\"\nconst inputData = $(\"Merged Data\").first().json;\n\n// Recuperiamo la riga dummy dal nodo \"Get header collection\"\nconst headersNode = $(\"Get header collection\").first();\n\nif (!headersNode || !headersNode.json) {\n    throw new Error(\"Errore: Il nodo 'Get header collection' non ha restituito dati validi.\");\n}\n\n// Estrazione chiavi filtrando il metadato row_number di n8n\nconst sheetHeaders = Object.keys(headersNode.json).filter(key => key !== 'row_number');\n\n// 2. LOGICA DI ALLINEAMENTO E GENERAZIONE TIMESTAMP\nconst finalizedRow = {};\nconst now = new Date().toISOString(); // Genera il timestamp ISO 8601 attuale\n\nsheetHeaders.forEach(header => {\n    // Se la colonna è il Timestamp, inseriamo l'ora esatta di adesso\n    if (header === \"Timestamp\") {\n        finalizedRow[header] = now;\n    } else {\n        // Altrimenti mappiamo il dato in ingresso o mettiamo null\n        finalizedRow[header] = inputData[header] ?? null;\n    }\n});\n\n// 3. RITORNO DATI\nreturn { json: finalizedRow };\n\n/**\n * PROSPETTIVA CRITICA:\n * Forzare il timestamp di sistema (now) garantisce la linearità del log nel database,\n * ma tieni presente che potrebbe esserci un leggero sfasamento (secondi) rispetto \n * all'istante esatto in cui il sensore ha campionato il dato.\n * Per un Digital Twin con campionamento a 5 minuti, questo scarto è irrilevante.\n */"
      },
