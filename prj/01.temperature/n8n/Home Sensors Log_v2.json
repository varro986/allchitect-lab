      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "// 1. Recupera la configurazione (path e nome colonna) dal nodo \"Switch\"\nconst config = $('Switch').item.json;\nconst path = config[\"JSON Key\"];\nconst columnName = config[\"Column name\"];\n\n// 2. Funzione per navigare nel JSON dello Shelly usando la stringa del path\nconst getValue = (obj, pathString) => {\n  return pathString.split('.').reduce((acc, part) => {\n    // Gestisce i casi con array come emeters[0]\n    const arrayMatch = part.match(/(\\w+)\\[(\\d+)\\]/);\n    if (arrayMatch) {\n      return acc[arrayMatch[1]][arrayMatch[2]];\n    }\n    return acc[part];\n  }, obj);\n};\n\n// 3. Mappa l'input attuale dello Shelly usando i dati di configurazione\nreturn $input.all().map(item => {\n  return {\n    json: {\n      [columnName]: getValue(item.json, path)\n    }\n  };\n});"
      },
