    {
      "parameters": {
        "jsCode": "/**\n * Nodo: Code in JavaScript\n * Obiettivo: Estrarre Device ID univoci e creare una stringa separata da virgole.\n */\n\n// 1. Recupero l'array dei Device ID dall'input (basato su image_0e87e8.png)\n// Assumiamo che l'input sia l'oggetto \"Aggregate\" mostrato nello screenshot\nconst rawIds = $input.all()[0].json[\"Device ID\"];\n\nif (!Array.isArray(rawIds)) {\n  throw new Error(\"Input non valido: 'Device ID' deve essere un array.\");\n}\n\n// 2. Rimozione duplicati e pulizia (trim)\n// L'uso di Set garantisce l'unicità dei valori\nconst uniqueIds = [...new Set(rawIds.map(id => id.trim()))];\n\n// 3. Creazione dello \"stringone\"\nconst idString = uniqueIds.join(\",\");\n\n// 4. Prospettiva Critica: Controllo dei limiti\n// Tuya Batch Query supporta massimo 20 ID per chiamata.\nconst deviceCount = uniqueIds.length;\nif (deviceCount > 20) {\n  // Nota: n8n non blocca l'esecuzione, ma l'API Tuya restituirà errore.\n  console.warn(`Attenzione: Hai ${deviceCount} ID. Il limite Tuya Batch è 20.`);\n}\n\n// 5. Restituisco l'output in formato n8n\nreturn [\n  {\n    json: {\n      idString: idString,\n      count: deviceCount,\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1520,
