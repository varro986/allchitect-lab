      "id": "4f9237ac-4cbc-4652-a585-968244bb2a68",
      "name": "Set Variables"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Nodo: Code in JavaScript\n * Obiettivo: Estrarre i dati da Open Meteo e mapparli sulle colonne del foglio secondo il Mapping.\n */\n\n// 1. Recupero dati Meteo dal nodo \"Open Meteo\"\nconst meteoInput = $input.all()[0].json;\n\nconst mappingData = $(\"Switch\").all().map(item => item.json);\n\n// 3. Elaborazione della riga sincronizzata\nconst finalRow = {};\n\nmappingData.forEach(row => {\n  const producer = row[\"Device Producer\"];\n  const jsonKey = row[\"JSON Key\"];\n  const columnName = row[\"Column name\"];\n  const multiplier = parseFloat(row[\"Multiplier\"]) || 1;\n  \n  let value = \"not available\";\n\n  // --- LOGICA ESCLUSIVA OPEN METEO ---\n  if (producer === \"Open Meteo\" && meteoInput && meteoInput.current) {\n    // Controllo se la chiave esiste nel blocco 'current' di Open Meteo\n    if (jsonKey && meteoInput.current[jsonKey] !== undefined) {\n      value = meteoInput.current[jsonKey];\n      \n      // Applicazione moltiplicatore se il valore è numerico\n      if (typeof value === 'number') {\n        value = value * multiplier;\n      }\n    }\n  }\n\n  // Popolamento della colonna (mantiene la struttura del foglio anche se vuota)\n  finalRow[columnName] = value;\n});\n\n// 4. Restituzione del record unico (Wide Format)\nreturn { json: finalRow };\n\n/**\n * ANALISI CRITICA:\n * 1. Coerenza Temporale: Questo script usa le chiavi del JSON Open Meteo (es. \"time\") \n * per popolare la colonna \"Timestamp\" se mappata correttamente nel foglio.\n * 2. Estensibilità: Se aggiungi nuovi parametri meteo (es. UV Index o Visibility) \n * nel nodo Open Meteo, ti basterà aggiungere la riga nel foglio Mapping \n * senza tornare a modificare questo codice.\n * 3. Prospettiva Alternativa: Se il nodo Open Meteo dovesse fallire (timeout), \n * lo script restituirà \"not available\" per tutte le colonne, evitando il crash \n * dell'intero workflow di logging.\n */"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
