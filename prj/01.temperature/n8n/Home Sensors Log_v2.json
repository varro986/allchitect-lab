      "name": "Switch"
    },
    {
      "parameters": {
        "jsCode": "/**\n * Nodo: Code in JavaScript\n * Obiettivo: Unire i dati grezzi Tuya con il Mapping prelevato da un nodo specifico.\n */\n\n// 1. Recupero dati Tuya (input diretto dal nodo precedente)\nconst tuyaInput = $input.all()[0].json; \nconst tuyaStatus = JSON.parse(tuyaInput.result);\n\n// 2. Recupero Mapping da un nodo specifico (es. \"Get Sensor Mapping\")\nconst mappingData = $(\"Switch\").all().map(item => item.json);\n\n// 3. Elaborazione dell'array sincronizzato\nconst output = mappingData.map(row => {\n  const deviceId = row[\"Device ID\"];\n  const jsonKey = row[\"JSON Key\"];\n  const columnName = row[\"Column name\"];\n  \n  let value = \"not available\";\n\n  // Match su Device ID e JSON Key\n  if (deviceId && tuyaStatus[deviceId]) {\n    const dataPoint = tuyaStatus[deviceId].find(dp => dp.code === jsonKey);\n    \n    if (dataPoint !== undefined) {\n      value = dataPoint.value;\n      \n      // Logica specifica richiesta: divisione per scala differente\n      // temp_set/upper_temp usano solitamente step da 0.5 (valore / 2)\n      // va_temperature/temp_current usano step da 0.1 (valore / 10)\n      if (jsonKey === \"temp_set\" || jsonKey === \"upper_temp\") {\n        value = value / 2;\n      } else if (jsonKey === \"va_temperature\" || jsonKey === \"temp_current\" || jsonKey === \"cur_power\") {\n        value = value / 10;\n      }\n\n      // Prospettiva Critica: Normalizzazione (Moltiplicatore dal Foglio)\n      const multiplier = parseFloat(row[\"Multiplier\"]) || 1;\n      if (typeof value === 'number') value = value * multiplier;\n    }\n  }\n\n  return {\n    \"Column name\": columnName,\n    \"Value\": value\n  };\n});\n\n// 4. Trasformazione in un unico oggetto (Wide Format) per Google Sheets\nconst finalRow = {};\noutput.forEach(item => {\n  finalRow[item[\"Column name\"]] = item[\"Value\"];\n});\n\nreturn { json: finalRow };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        -960
